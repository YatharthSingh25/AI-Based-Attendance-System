# AI Attendance System - Frontend Environment Variables
# Copy to .env for local development. Vite embeds these values at BUILD time,
# so set them in the hosting dashboard before building for production.

# Backend API base URL (no trailing slash)
# Local: http://127.0.0.1:8000
# Production: your deployed backend HTTPS origin
# The matching origin of this frontend must be listed in backend CORS_ORIGINS.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Application display label
VITE_APP_NAME=AI Attendance System

# development | production
VITE_ENVIRONMENT=development
