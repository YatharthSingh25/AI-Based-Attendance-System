# AI Attendance System - Backend Environment Variables
# Copy to .env for local development, or set these in your hosting dashboard.
# NEVER commit real secrets. Values below are placeholders only.

# Runtime environment: development | production
# In production the backend refuses to start unless JWT_SECRET is a strong,
# non-default value of at least 32 characters and DATABASE_URL is an explicit
# PostgreSQL URL (SQLite and the local default are rejected).
ENVIRONMENT=development

# PostgreSQL connection string (PostgreSQL is required for production)
DATABASE_URL=postgresql://<db_user>:<db_password>@<db_host>:5432/<db_name>

# JWT signing configuration
# Generate a secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=<replace-with-a-random-secret-at-least-32-characters>
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=30

# Comma-separated list of allowed browser origins (no trailing slash)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Administrator bootstrap - used ONLY by: python -m app.seed_admin
# Do not set these on the long-running web service. Remove them after seeding.
# Public registration may create STUDENT/FACULTY accounts; ADMIN is seed-only.
# ADMIN_EMAIL=<admin-email>
# ADMIN_PASSWORD=<strong-password-min-12-chars>
# ADMIN_NAME=<admin-display-name>
